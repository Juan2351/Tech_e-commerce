SECRET_KEY=replace-with-a-random-local-secret
DATABASE_PATH=database/lepetit.sqlite3
DATASET_CSV_PATH=database/data/amazon_tech_products_ecommerceGKALI.csv
USD_TO_COP_RATE=4200
SESSION_COOKIE_SECURE=false

# Firebase Database
DATABASE_BACKEND=firebase
FIREBASE_DATABASE_URL=https://lepetit-e4386-default-rtdb.firebaseio.com
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Opcional para HTTPS local. Configura ambas rutas o ninguna.
# SSL_CERT_FILE=cert.pem
# SSL_KEY_FILE=key.pem
