title C3 · Componentes de la aplicación Flask

Container_Boundary(web, "Backend LePetit · Python y Flask") {
    Component(shop_controller, "Controlador de tienda", "Flask Blueprint", "Renderiza catálogo, detalle y carrito.")
    Component(api_controller, "Controlador API", "Flask Blueprint", "Valida y responde a solicitudes REST.")
    Component(cart_service, "Servicio de carrito", "Python", "Valida cantidades y disponibilidad.")
    Component(catalog_repository, "Repositorio de catálogo", "models/catalog.py", "Consulta productos y categorías.")
    Component(product_model, "Modelo Product", "dataclass", "Representa y serializa los productos.")
    Component(database, "Adaptador MySQL", "mysql.connector", "Ejecuta consultas SQL parametrizadas.")
}
ContainerDb(mysql, "Base de datos", "MySQL 8", "Productos, marcas y categorías.")

Rel(shop_controller, catalog_repository, "Lee catálogo")
Rel(shop_controller, cart_service, "Resume carrito")
Rel(api_controller, catalog_repository, "Lee catálogo y stock")
Rel(api_controller, cart_service, "Valida operaciones")
Rel(catalog_repository, product_model, "Crea entidades")
Rel(catalog_repository, database, "Solicita datos")
Rel(database, mysql, "Consulta", "SQL")

