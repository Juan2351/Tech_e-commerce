flowchart LR
    navegador["JavaScript<br/>sendCartRequest()<br/>Envía producto y cantidad"]
    api["APIController<br/>add_cart_product()<br/>Valida la solicitud JSON"]
    service["CartService<br/>add_product()<br/>Comprueba cantidad y stock"]
    repository["CatalogRepository<br/>fetch_product()<br/>Busca el producto"]
    database["DatabaseAdapter<br/>query_one()<br/>SQL parametrizado"]
    sqlite[("SQLite<br/>producto · marca<br/>subcategoría")]
    session[("FlaskSession<br/>Cookie firmada<br/>productId → cantidad")]
    product["Product<br/>id_producto · precio<br/>stock"]

    navegador -->|"POST · JSON"| api
    api -->|"Delega validación"| service
    service -->|"Consulta producto y stock"| repository
    repository -->|"Ejecuta consulta"| database
    database -->|"Consulta SQL"| sqlite
    repository -->|"Crea entidad"| product
    api -->|"Guarda cantidad"| session

    classDef frontend fill:#EAF2FF,stroke:#3973B9,color:#10233F,stroke-width:2px,font-size:16px;
    classDef controller fill:#DDEBFA,stroke:#3973B9,color:#10233F,stroke-width:2px,font-size:16px;
    classDef business fill:#E7F5F2,stroke:#318477,color:#153E3A,stroke-width:2px,font-size:16px;
    classDef data fill:#FFF2D6,stroke:#C48A24,color:#4A3512,stroke-width:2px,font-size:16px;
    class navegador frontend;
    class api controller;
    class service,repository,product business;
    class database,sqlite,session data;
    linkStyle default stroke:#58708E,stroke-width:2px;
