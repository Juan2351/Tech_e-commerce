C4Container
title C2 · Contenedores de LePetit

Person(cliente, "Cliente", "Navega y agrega productos al carrito.")
System_Boundary(lepetit, "LePetit · tienda web") {
    Container(browser, "Navegador", "HTML · CSS · JavaScript", "Muestra la tienda y consume la API del mismo origen.")
    Container(web, "Aplicación web", "Python · Flask · Jinja", "Entrega las vistas, valida solicitudes y aplica las reglas del carrito.")
    ContainerDb(mysql, "Base de datos", "MySQL 8", "Almacena productos, marcas y categorías.")
}
System_Ext(imagenes, "CDN de imágenes", "Imágenes de muestra servidas por HTTPS.")

Rel(cliente, browser, "Navega la tienda")
Rel(browser, web, "HTML y API JSON", "HTTP local · HTTPS en despliegue")
Rel(web, mysql, "Consulta el catálogo", "SQL · MySQL")
Rel(browser, imagenes, "Carga imágenes", "HTTPS")

